# Скопируйте в .env и заполните то, что нужно.
# Приложение читает переменные окружения при старте (uvicorn).

# --- источники --------------------------------------------------------------
# Путь к бинарнику gosom/google-maps-scraper (Google Maps)
GMSC_PATH=C:\Users\Hlusha\Desktop\qwerty\parsers\01-gosom-google-maps-scraper\gmsc.exe

# Глубина прокрутки выдачи Google (1..10). По умолчанию 2.
# GMSC_DEPTH=2
# Радиус Google в метрах. По умолчанию считается по размеру квадрата.
# GMSC_RADIUS=

# Папка с yamaps_parser (Яндекс.Карты)
YAMAPS_DIR=C:\Users\Hlusha\Desktop\qwerty\parsers\03-yandex-maps-parser

# Папка с parser-2gis-new (2ГИС)
TWOGIS_DIR=C:\Users\Hlusha\Desktop\qwerty\parsers\02-2gis-parser-eroloft

# Город для 2ГИС-браузера, если в запросе не указан city (латиницей, как в URL):
# tyumen, moscow, spb
TWOGIS_CITY=tyumen

# Ключ официального API 2ГИС (необязательно; без него работает браузерный режим)
TWOGIS_API_KEY=

# Максимум записей за один прогон 2ГИС и таймаут в секундах
# TWOGIS_MAX_RECORDS=500
# TWOGIS_TIMEOUT=280

# --- режимы -----------------------------------------------------------------
# 1 = добавить демонстрационный источник (данные помечаются как ДЕМО)
PARSER_DEMO=0

# Путь к файлу БД
# PARSER_DB=C:\path\to\parser.db

# --- сервер -----------------------------------------------------------------
PARSER_PORT=8777
